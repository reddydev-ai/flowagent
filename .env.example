# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# REQUIRED for API requests (use two distinct random values)
FLOWAGENT_API_KEY=
FLOWAGENT_REVIEWER_KEY=

# --- Web search tool (optional but recommended) ---
# Without this, the research node returns a clear stub and the graph still runs.
TAVILY_API_KEY=tvly-your-key-here

# --- Models ---
CHAT_MODEL=gpt-4o

# --- Persistence ---
# Leave empty to use an in-memory checkpointer (demo).
# Set to a Postgres URL for persistent checkpointing that survives restarts:
#   postgresql://user:password@host:5432/flowagent
DATABASE_URL=

# --- Compliance config ---
REQUIRED_DOCS=Certificate of Insurance,WSIB Clearance,GST/HST Registration,Signed MSA
